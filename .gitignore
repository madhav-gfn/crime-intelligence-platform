# ==========================================================================
# Python (backend/services/*, ml-pipeline/, scripts/, nlp-models/)
# ==========================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Jupyter (ml-pipeline notebooks, exploratory analysis)
.ipynb_checkpoints/

# ==========================================================================
# Node / frontend (frontend/web-app/)
# ==========================================================================
node_modules/
.pnp/
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.next/
.nuxt/
.cache/
coverage/
*.tsbuildinfo

# ==========================================================================
# ML / NLP model artifacts - trained on Kaggle, pulled in as versioned
# artifacts, not committed to git (see data/raw/MANIFEST.md for the
# equivalent policy on raw datasets)
# ==========================================================================
*.pkl
*.pt
*.pth
*.h5
*.hdf5
*.onnx
*.safetensors
*.ckpt
*.bin
mlruns/
wandb/

# ==========================================================================
# Data - raw/processed/seed are multi-GB and fully reproducible via
# scripts/data_generation/ + data/raw/MANIFEST.md (provenance) - never commit
# the data itself, only the generation code and schema docs.
# ==========================================================================
data/raw/
data/processed/
data/seed/*.csv

# Per-service data copies staged by scripts/deploy/stage_service_data.py for
# Zoho Catalyst AppSail deployment (see docs/deployment/DEPLOY.md) - same
# reproducible-not-committed policy as the shared data/ dir above.
backend/services/*/data/

# ==========================================================================
# Confidential source documents - internal reference only, never pushed
# ==========================================================================
docs/architecture/Police_FIR_ER_Diagram.pdf

# ==========================================================================
# Infra (infra/terraform, infra/kubernetes, infra/docker)
# ==========================================================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraformrc
terraform.rc
crash.log
kubeconfig
*.kubeconfig

# Zoho Catalyst - .catalystrc holds a local portal/project mapping,
# machine-specific, not meant to be shared (see docs/architecture/Zoho
# Catalyst Deployment Architecture and Configuration.md)
.catalystrc

# ==========================================================================
# Secrets / local config - never commit credentials of any kind
# ==========================================================================
.env
.env.*
!.env.example
*.local
kaggle.json
*.pem
*.key
credentials.json
service-account*.json

# ==========================================================================
# Logs
# ==========================================================================
*.log
logs/

# ==========================================================================
# OS / editor
# ==========================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

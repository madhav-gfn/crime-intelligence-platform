# Copy to .env and fill in real values before any non-local deployment.
# .env is gitignored - never commit real secrets.

# Shared across ALL 8 services (must be byte-identical everywhere, or
# tokens minted here won't verify downstream - see README.md).
JWT_SECRET=dev-only-insecure-secret-change-me-via-JWT_SECRET-env-var
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rarely needs overriding - defaults to <repo>/data/processed/auth/users.json
# USERS_PATH=

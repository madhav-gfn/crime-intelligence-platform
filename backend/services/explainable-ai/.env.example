# Copy to .env and fill in real values before any non-local deployment.
# .env is gitignored - never commit real secrets.

# Must match auth-service's JWT_SECRET/JWT_ALGORITHM exactly (see
# backend/services/auth-service/README.md).
JWT_SECRET=dev-only-insecure-secret-change-me-via-JWT_SECRET-env-var
JWT_ALGORITHM=HS256

# Rarely need overriding - default to <repo>/data/processed/explainability/*
# and <repo>/data/processed/offender-profiling/* (read directly, same
# tradeoff investigator-decision-support makes - see its README).
# SHAP_VALUES_PATH=
# GLOBAL_IMPORTANCE_PATH=
# MODEL_PATH=
# FEATURE_METADATA_PATH=
# PERSON_SCORES_PATH=
# PERSON_FEATURE_VECTORS_PATH=
# OFFENDER_EVAL_STATS_PATH=
# DATA_SEED_DIR=

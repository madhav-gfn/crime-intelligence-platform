{
  "command": "python3 -m uvicorn app.main:app --host 0.0.0.0 --port $X_ZOHO_CATALYST_LISTEN_PORT",
  "buildPath": "./",
  "stack": "python3.13",
  "memory": 1024,
  "env_variables": {
    "SHAP_VALUES_PATH": "./data/processed/explainability/shap_values.csv",
    "GLOBAL_IMPORTANCE_PATH": "./data/processed/explainability/global_importance.json",
    "MODEL_PATH": "./data/processed/offender-profiling/model.pkl",
    "FEATURE_METADATA_PATH": "./data/processed/offender-profiling/feature_metadata.json",
    "PERSON_SCORES_PATH": "./data/processed/offender-profiling/person_risk_scores.csv",
    "PERSON_FEATURE_VECTORS_PATH": "./data/processed/offender-profiling/person_feature_vectors.csv",
    "OFFENDER_EVAL_STATS_PATH": "./data/processed/offender-profiling/eval_stats.json",
    "DATA_SEED_DIR": "./data/seed"
  }
}

# Copy to .env and fill in real values before any non-local deployment.
# .env is gitignored - never commit real secrets.

# Must match auth-service's JWT_SECRET/JWT_ALGORITHM exactly (see
# backend/services/auth-service/README.md).
JWT_SECRET=dev-only-insecure-secret-change-me-via-JWT_SECRET-env-var
JWT_ALGORITHM=HS256

# Rarely need overriding - default to <repo>/data/processed/sociology/*
# DISTRICT_DATA_PATH=
# MATCH_STATS_PATH=

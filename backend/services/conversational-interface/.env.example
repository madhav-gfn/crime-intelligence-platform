# Copy to .env and fill in real values before any non-local deployment.
# .env is gitignored - never commit real secrets.

# Must match auth-service's JWT_SECRET/JWT_ALGORITHM exactly (see
# backend/services/auth-service/README.md).
JWT_SECRET=dev-only-insecure-secret-change-me-via-JWT_SECRET-env-var
JWT_ALGORITHM=HS256

# Rarely need overriding - default to <repo>/data/seed.
# DATA_SEED_DIR=

# Base URLs of the downstream services this router calls live over HTTP -
# see app/config.py for why this service (unlike every other cross-service
# consumer in this platform) doesn't read precomputed files directly.
# Defaults assume every service is running locally on its documented port.
# NETWORK_ANALYSIS_URL=http://localhost:8010
# PATTERN_ANALYTICS_URL=http://localhost:8011
# FINANCIAL_CRIME_ANALYSIS_URL=http://localhost:8013
# CRIME_FORECASTING_URL=http://localhost:8014
# OFFENDER_PROFILING_URL=http://localhost:8016
# INVESTIGATOR_DECISION_SUPPORT_URL=http://localhost:8018
# EXPLAINABLE_AI_URL=http://localhost:8021
# DOWNSTREAM_TIMEOUT_SECONDS=10.0
